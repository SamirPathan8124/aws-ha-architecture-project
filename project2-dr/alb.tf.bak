resource "aws_lb" "dr" {
  provider           = aws.dr
  name               = "dr-alb"
  load_balancer_type = "application"
  security_groups    = [aws_security_group.dr_alb.id]
  subnets            = aws_subnet.dr_public[*].id
}

resource "aws_lb_target_group" "dr" {
  provider = aws.dr
  name     = "dr-tg"
  port     = 80
  protocol = "HTTP"
  vpc_id   = aws_vpc.dr.id

  health_check {
    path    = "/"
    matcher = "200"
  }
}

resource "aws_lb_listener" "dr_http" {
  provider          = aws.dr
  load_balancer_arn = aws_lb.dr.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.dr.arn
  }
}

resource "aws_autoscaling_attachment" "dr" {
  provider               = aws.dr
  autoscaling_group_name = aws_autoscaling_group.dr.id
  lb_target_group_arn    = aws_lb_target_group.dr.arn
}

output "dr_alb_dns" {
  value = aws_lb.dr.dns_name
}